NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://respect:respect@localhost:5432/respect_city
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRES_IN=7d
# Session cookie `Secure` flag. Default: true when NODE_ENV=production.
# Set it to false only when serving over plain HTTP (e.g. the bundled compose
# stack on :8080); a Secure cookie is dropped by the browser over http.
COOKIE_SECURE=false